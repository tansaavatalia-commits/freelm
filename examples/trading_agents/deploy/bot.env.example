# Copia a bot.env y rellena. NUNCA lo subas a git (chmod 600 bot.env).

# Analista IA (opcional, gratis): https://aistudio.google.com/apikey  https://console.groq.com/keys
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Exchange: SOLO para la fase 2 (dinero real) o testnet.
# Crea la clave con permiso de TRADING y SIN permiso de RETIRADA, restringida a la IP del servidor.
FREELM_EXCHANGE_KEY=
FREELM_EXCHANGE_SECRET=

# Avisos al móvil por Telegram (opcional, gratis): @BotFather -> /newbot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
