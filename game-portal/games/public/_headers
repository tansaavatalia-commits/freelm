# Header per l'origin dei giochi (progetto Pages separato, es. play.<dominio>).
# Solo il portale può incorporare i giochi; nessun cookie viene mai impostato qui.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'none'; frame-ancestors https://www.tabluo.example; base-uri 'none'; form-action 'none'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Resource-Policy: cross-origin
